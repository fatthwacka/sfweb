# Production Environment Variables Template
# Copy this file to /opt/sfweb/.env on the VPS and fill in the actual values
# 
# SECURITY WARNING: This file contains sensitive credentials
# - Set permissions: chmod 600 .env
# - Never commit to git
# - Keep backups in secure location

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://postgres:your_postgres_password@sfweb-postgres:5432/slyfox_studios

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# =============================================================================
# EMAIL CONFIGURATION (Gmail SMTP)
# =============================================================================
# IMPORTANT: Use Gmail App Password, not regular password
# Generate at: https://myaccount.google.com/apppasswords
SMTP_EMAIL=dax.tucker@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# =============================================================================
# RECAPTCHA CONFIGURATION (v3)
# =============================================================================
# Get keys from: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=6Le3Y7YrAAAAAJn-74S3y_kLoDIax3vY6MyisDPs
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# =============================================================================
# DROPBOX CONFIGURATION
# =============================================================================
# KNOWN ISSUE: Dropbox tokens expire every 4 hours
# TODO: Implement refresh token mechanism
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token_here
DROPBOX_APP_KEY=your_dropbox_app_key_here
DROPBOX_APP_SECRET=your_dropbox_app_secret_here

# =============================================================================
# PRODUCTION ENVIRONMENT
# =============================================================================
NODE_ENV=production

# Media store (Google Cloud Storage) — gallery images/videos, preview images, brand assets.
# Uses the GOOGLE_* service-account credentials above. Defaults shown.
GCS_MEDIA_BUCKET=sfweb-media
GCS_ARCHIVE_BUCKET=sfweb-media-archive
MEDIA_PUBLIC_BASE=https://storage.googleapis.com/sfweb-media
VITE_MEDIA_BASE_URL=https://storage.googleapis.com/sfweb-media
